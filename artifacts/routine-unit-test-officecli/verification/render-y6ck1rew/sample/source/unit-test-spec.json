    "routine_name": "AlarmQualification_Update",
    "template_id": "unit-test-spec-v01",
    "author": "OpenAI Codex AI作成・独立レビュー前・人による承認待ち（Bob実施ではない）"
  },
  "target": {
    "program_spec_sha256": "097b1185e284c17805b51c92dd821d1bec64f55d0ce1781c2c1fb369239b4265",
